# Interfaz de escucha; usar 0.0.0.0 para permitir conexiones desde otras computadoras.
HOST=0.0.0.0
PORT=3000

# Origen exacto de React (esquema, host y puerto), separados por coma si hay varios.
CORS_ORIGINS=http://localhost:5173

# URI de Supabase: proyecto compartido > Connect > Direct Connection string.
# Para Render, usá Shared pooler y conservá el host, puerto y usuario que muestra Supabase.
# Guardá la contraseña solo en tu .env local y en las variables del servicio en Render.
# DATABASE_URL=postgresql://usuario:contraseña@host:5432/postgres?sslmode=require

# Búsqueda de ciudades GeoDB (RapidAPI); guardá la clave solo en .env/Render.
# GEODB_RAPIDAPI_KEY=

# Rutas en auto con OpenRouteService; sin clave se usa distancia geográfica aproximada.
# ORS_API_KEY=

# Fotografías de destinos de Unsplash (con atribución al fotógrafo en la interfaz).
# UNSPLASH_ACCESS_KEY=

# SMTP para mandar la verificación (usa contraseña de aplicación/token SMTP, no la de Supabase).
# SMTP_HOST=
SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=SmartTrip <no-reply@tu-dominio-verificado.com>
FRONTEND_URL=http://localhost:5173
EMAIL_VERIFICATION_PATH=/confirmar-correo

# Valores referenciales para las estimaciones del prototipo, en USD.
ESTIMATED_LODGING_USD=60
ESTIMATED_FOOD_USD=30
ESTIMATED_ACTIVITIES_USD=15
ESTIMATED_TRAIN_PER_KM_USD=0.14
ESTIMATED_FLIGHT_PER_KM_USD=0.18
ESTIMATED_CAR_PER_KM_USD=0.18

# Parámetros de seguridad y expiración (milisegundos).
BCRYPT_ROUNDS=12
VERIFICATION_TOKEN_TTL_MS=86400000
SESSION_TTL_MS=28800000

# Solo para desarrollo local; no activar en producción.
PRINT_VERIFICATION_TOKENS=false
RETURN_VERIFICATION_TOKENS=false
