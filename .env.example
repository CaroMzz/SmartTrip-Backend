# Interfaz de escucha; usar 0.0.0.0 para permitir conexiones desde otras computadoras.
HOST=0.0.0.0
PORT=3000

# Origen exacto de React (esquema, host y puerto), separados por coma si hay varios.
CORS_ORIGINS=http://localhost:5173

# Parámetros de seguridad y expiración (milisegundos).
BCRYPT_ROUNDS=12
VERIFICATION_TOKEN_TTL_MS=86400000
SESSION_TTL_MS=28800000

# Solo para desarrollo local; no activar en producción.
PRINT_VERIFICATION_TOKENS=false
